# Supabase project URL and anon (public) key.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose to the browser — RLS policies are the
# real access-control gate, not this key. Never put the service_role key
# in a VITE_ prefixed variable or anywhere client-side code can read it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
