# TEMPLATE ONLY — copy to .env.staging.local (gitignored) and fill in your
# STAGING project's values. Never put production values here; the staging
# scripts refuse to run if anything points at the production project in .env.
#
# Only VITE_-prefixed values are ever bundled into the browser app, and
# only these two are safe there. Everything below them stays on your machine.

# Staging project: Project Settings -> API
VITE_STAGING_SUPABASE_URL=https://your-staging-ref.supabase.co
VITE_STAGING_SUPABASE_ANON_KEY=your-staging-anon-key

# Staging database: Connect (top bar) -> Session pooler -> URI.
# Replace [YOUR-PASSWORD] with the staging database password; percent-encode
# special characters (@ -> %40, # -> %23, / -> %2F, : -> %3A).
STAGING_DB_URL=postgresql://postgres.your-staging-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional but recommended: path (relative to the project folder) to the
# staging CA certificate from Database Settings -> SSL Configuration.
STAGING_DB_SSL_CA=

# Test accounts you create on STAGING (step 6). Use passwords you don't use
# anywhere else, and never your production password.
STAGING_ADMIN_EMAIL=your-staging-admin@example.com
STAGING_ADMIN_PASSWORD=your-staging-admin-password
STAGING_EDITOR_EMAIL=
STAGING_EDITOR_PASSWORD=
