{
  "name": "equipment-ledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:db": "vitest run --config vitest.db.config.ts",
    "staging:migrate": "node scripts/staging/apply-migrations.mjs",
    "staging:seed": "node scripts/staging/seed-synthetic.mjs",
    "staging:smoke": "node scripts/staging/smoke-test.mjs",
    "staging:test-db": "node scripts/staging/run-db-tests.mjs",
    "staging:compare": "node scripts/staging/compare-fingerprints.mjs",
    "dev:staging": "vite --mode staging",
    "staging:set-role": "node scripts/staging/set-role.mjs",
    "staging:reset": "node scripts/staging/reset.mjs",
    "staging:test-files": "node scripts/staging/make-test-files.mjs",
    "staging:verify": "vitest run --config vitest.staging.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "html5-qrcode": "^2.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/pg": "8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
